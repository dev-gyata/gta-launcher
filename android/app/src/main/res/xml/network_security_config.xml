<?xml version="1.0" encoding="utf-8"?>
<!-- The game is served by the app itself over plain HTTP on localhost (a secure context for the browser,
     which the game's shared memory needs). Cleartext stays blocked for every other host. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
